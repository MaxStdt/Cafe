{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug with file args",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": "${command:pickArgs}"
        }
    ]
}